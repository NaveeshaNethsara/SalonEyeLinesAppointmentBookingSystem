# Salon EyeLines - Production Environment Variables Template
# Copy this file to .env and insert your real production secrets.
# NEVER commit the real .env file with actual database passwords to Git!

# 1. Connect to Postgres via the shared transaction-mode pooler (runtime queries, port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Connect to Postgres via the direct session-mode pooler (migrations & db push, port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 3. Cryptographic Session Secret (Generate with: openssl rand -hex 32)
AUTH_SECRET="your-64-character-cryptographic-secret-here"

# 4. Master Admin Initial Credentials (used exclusively during initial 'prisma db seed')
# NEVER commit these credentials to version control or public repositories
ADMIN_INITIAL_EMAIL="admin@saloneyelines.com"
ADMIN_INITIAL_PASSWORD="EyeLines@YourSecurePassword2026!"
